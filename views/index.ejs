<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.5.0/css/all.css">
  <style class="text/css">
    .main {
      padding: 0 20px;
    }
    .title {
      display: flex;
      justify-content: center;
    }
    .select_button {
      padding: 10px 35%;
    }
    .vocabulary_button, .play_button {
      margin-top: 20px;
      margin-bottom: 20px;
      display: flex;
      justify-content: center;
      align-items: center;
      text-decoration: none;
      border: solid 5px;
      border-radius: 10px;
      color: inherit;
      font-weight: bold;
      font-size: 24px;
    }
    .vocabulary_button:hover {
      color: #ff321e;
    }
    .play_button:hover {
      color: #ff321e;
    }
    .article {
      display: flex;
      justify-content: center;
      align-items: center;
    }
  </style>
  <title>メニュー画面</title>
</head>
<body>
  <div class="main">
    <div class="title">
      <img src="../images/English_game_title_update.png" alt="ゲームタイトル" height="200px">
    </div>
    <div class="select_button">
      <a class="play_button" href="/start"><i class="fas fa-chess-queen" style="padding-right: 10px;"></i>ゲームを遊ぶ</a>
      <a class="vocabulary_button" href="/vocabulary" ><i class="fas fa-eye" style="font-size: 18px; padding-right: 10px;"></i>収録されている英単語を見る</a>
    </div>
  </div>
  <div class="article">
    <span>Bella questa!</span>
  </div>
</body>
</html>